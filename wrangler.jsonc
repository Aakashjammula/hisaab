{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hisaab",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-22",

  // The free *.workers.dev URL and preview URLs are NOT behind Cloudflare Access.
  // Keep them off so the app is only reachable on your Access-protected domain.
  "workers_dev": false,
  "preview_urls": false,

  // Set your subdomain (the zone must be on your Cloudflare account), e.g. "hisaab.example.com".
  "routes": [{ "pattern": "hisaab.aakashjammula.com", "custom_domain": true }],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hisaab",
      "database_id": "16ed96e6-c731-48fa-af97-6fbfd82ea71a",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "TIME_ZONE": "Asia/Kolkata",
    // From Zero Trust > Settings > Custom pages / team domain, e.g. "https://yourteam.cloudflareaccess.com"
    "TEAM_DOMAIN": "https://aakashjammula.cloudflareaccess.com",
    // From Zero Trust > Access > Applications > (your app) > Overview > Application Audience (AUD) Tag
    "POLICY_AUD": "115b16983adee4891c3730d73eff2116cf55a67cb308053e0d570715f0cb67c3"
    // ALLOWED_EMAIL is a secret (kept out of git): npx wrangler secret put ALLOWED_EMAIL
  },

  "observability": { "enabled": true }
}
