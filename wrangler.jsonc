{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hisaab",
  "main": "src/adapters/cloudflare/worker.ts",
  "compatibility_date": "2026-08-22",

  // The free *.workers.dev URL and preview URLs are NOT behind Cloudflare Access.
  // Keep them off so the app is only reachable on your Access-protected domain.
  "workers_dev": false,
  "preview_urls": false,

  // Set your subdomain (the zone must be on your Cloudflare account), e.g. "hisaab.example.com".
  "routes": [{ "pattern": "hisaab.aakashjammula.com", "custom_domain": true }],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hisaab",
      "database_id": "16ed96e6-c731-48fa-af97-6fbfd82ea71a",
      "migrations_dir": "migrations"
    }
  ],

  // Email the login codes are sent from (domain must have Cloudflare Email Routing enabled).
  // Free when the recipient is a verified destination address in this account.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "APP_NAME": "Hisaab",
    "TIME_ZONE": "Asia/Kolkata",
    "MAIL_FROM": "noreply@aakashjammula.com",
    // closed = only ALLOWED_EMAILS can sign in; invite = ALLOWED_EMAILS get accounts on first login; open = anyone
    "AUTH_MODE": "closed",
    // Shown to emails that aren't allowed to sign in. Route it to your inbox with Email Routing.
    "CONTACT_EMAIL": "contact@aakashjammula.com"
    // Secrets (not in git):
    //   npx wrangler secret put AUTH_SECRET      (random, e.g. `openssl rand -base64 32`)
    //   npx wrangler secret put ALLOWED_EMAILS   (comma-separated)
  },

  "observability": { "enabled": true }
}
